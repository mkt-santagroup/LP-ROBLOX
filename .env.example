# Modelo do .env — copie para `.env` e preencha.
#   cp .env.example .env
#
# ⚠️ Tudo que começa com VITE_ é embutido no bundle e fica PÚBLICO no navegador.
#    Use SEMPRE a chave "anon public" do Supabase, nunca a service_role.
# Depois de editar o .env, REINICIE o `npm run dev` (o Vite só lê no boot).

# ===== Supabase (obrigatório) =====
# Project Settings -> Data API -> "Project URL" e "anon public"
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ===== Senha do painel /admin (obrigatório) =====
VITE_ADMIN_PASSWORD=sua_senha_do_admin

# ===== Redirecionamento da LP (opcional) =====
# Prioridade: influencer > config global (/admin/configuracoes) > este valor > padrão do código.
VITE_REDIRECT_URL=https://www.roblox.com/games/start?launchData=utm1%3A0%2C0%2Cweb-link%2Cnavbar-play-button%2C%3B&placeId=124924744052568
# Tempo da tela de "redirecionando" em ms (1000–15000; recomendado 3000–5000).
VITE_REDIRECT_DELAY_MS=4000

# ===== Meta (Facebook) Ads — aba /admin/anuncios (opcional) =====
# ⚠️ O token fica PÚBLICO no bundle. Deixe vazio se preferir não expor.
VITE_META_TOKEN=EAA...
VITE_META_AD_ACCOUNT=act_000000000000000
# Tag no nome das campanhas (match por "contém"). Vazio = todas as campanhas.
VITE_META_PREFIXO_CAMPANHA=[ROBLOX]

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ADMIN_PASSWORD=your_admin_password

# ===== Meta (Facebook) Ads — aba /admin/anuncios =====
# ⚠️ Lidas direto pelo front: por serem VITE_*, ficam PÚBLICAS no bundle do navegador.
VITE_META_TOKEN=EAA...
VITE_META_AD_ACCOUNT=act_000000000000000
# Tag no nome das campanhas (match por "contém"). Vazio = todas as campanhas.
VITE_META_PREFIXO_CAMPANHA=[ROBLOX]
